   "id": "298c2ace-bc15-48e4-811d-3f277578a397",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Set the linear matter power spectrum at z=0\n",
    "d = np.loadtxt('data/pk_lin_planck18_fid_z0.txt')\n",
    "k, pk_lin = d[:,0], d[:,1]\n",
    "model.set_pk_lin(k, pk_lin)\n",
    "\n",
    "## Preparation for computing 1-loop terms\n",
    "model.set_1loop(hubble=0.6736)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "f6a8ffde-cf3b-4d75-9fa3-349cfe1af807",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Set the linear growth factor D (normalized as D(z=0)=1) and the linear growth rate f. \n",
    "## Here, we want to compute the galaxy power spectrum at z=1 in Planck 2018 cosmology.\n",
    "model.set_Dgrowth(Dgrowth=0.6067)\n",
    "model.set_fgrowth(fgrowth=0.8768)\n",
    "\n",
    "## Set galaxy bias parameters\n",
    "bias = {'b1':2., 'b2':-1., 'bG2':0.1, 'bGamma3':-0.1}\n",
    "model.set_bias_params(bias)\n",
    "\n",
    "## Set EFT counterterm parameters\n",
    "ctr = {'c0':5., 'c2':15., 'c4':-5., 'cfog':100.}\n",
    "model.set_ctr_params(ctr)\n",
    "\n",
    "## Set stochasticity parameters\n",
    "stoch = {'P_shot':0., 'a0':0., 'a2':0.} # means no stochasticity\n",
    "model.set_stoch_params(stoch=stoch, ndens=3e-4, k_nl=0.45)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "8508da03-1751-437d-a10f-713cf2813150",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Output P(k,mu) as numpy array of shape (len(k), len(mu))\n",
    "k = np.linspace(1e-3,0.3,100)\n",
    "mu = np.linspace(0,1,10)\n",
    "pkmu = model.get_pkmu_gg(k, mu, irres=True)"
   ]
  },
